# Exclude all dot-directories & agentic AI / tooling folders (.specify, .agents, .gemini, etc.)
.*
!.gitignore
!.env.example

# Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# Local Environment Variables & Secrets
.env
.env.local
.env.*.local
*.secret

# SQLite Databases & Local Storage
*.db
*.sqlite
*.sqlite3

# OS & Editor Files
.DS_Store
Thumbs.db
